<!DOCTYPE html>
<html lang="en">
<head>
    <title>Current Temperatures — AW Graphs</title>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container">
        <div class="page-header">
            <h1 class="page-title">Current Temperatures</h1>
            <span class="last-update" id="lastUpdate">Loading…</span>
        </div>

        <div id="outdoorHero" class="outdoor-hero" style="display:none;">
            <p class="outdoor-temp" id="outdoorTemp">—°F</p>
            <span class="outdoor-label" id="outdoorName">Outside</span>
            <p class="outdoor-meta" id="outdoorMeta"></p>
        </div>

        <div class="sensor-grid" id="sensorGrid">
            <!-- Populated by JS -->
        </div>
    </div>

    <script>
        let refreshTimer = null;

        function fmt1(v) {
            return (v != null && typeof v === 'number') ? v.toFixed(1) : '—';
        }

        function battBadge(battOk) {
            if (battOk === 1) return '<span class="battery-badge battery-ok">Battery OK</span>';
            if (battOk === 0) return '<span class="battery-badge battery-low">Battery Low</span>';
            return '';
        }

        function renderReadings(readings) {
            const grid = document.getElementById('sensorGrid');
            const hero = document.getElementById('outdoorHero');

            if (!readings || readings.length === 0) {
                grid.innerHTML = '<p style="color:var(--text-muted)">No data yet — collection may be in progress.</p>';
                return;
            }

            // First enabled channel drives the hero card
            const outdoor = readings[0];
            document.getElementById('outdoorTemp').textContent = fmt1(outdoor.temp_f) + '°F';
            document.getElementById('outdoorName').textContent = outdoor.name || outdoor.channel_key;
            const dt = outdoor.recorded_at ? new Date(outdoor.recorded_at).toLocaleString() : '';
            document.getElementById('outdoorMeta').textContent = `Humidity ${fmt1(outdoor.humidity)}% · Updated ${dt}`;
            hero.style.display = '';

            grid.innerHTML = readings.map(r => `
                <div class="sensor-card" style="border-left-color:${r.color || '#3b82f6'}">
                    <div class="sensor-header">
                        <span class="sensor-name">${r.name || r.channel_key}</span>
                        ${battBadge(r.battery_ok)}
                    </div>
                    <div class="temp-value">${fmt1(r.temp_f)}°F</div>
                    <div class="sensor-metrics">
                        <div>Humidity<div class="metric-value">${fmt1(r.humidity)}%</div></div>
                        <div>Feels Like<div class="metric-value">${fmt1(r.feels_like_f)}°F</div></div>
                        <div>Dew Point<div class="metric-value">${fmt1(r.dew_point_f)}°F</div></div>
                    </div>
                </div>
            `).join('');
        }

        async function load() {
            try {
                const res = await fetch('/api/current');
                const data = await res.json();
                renderReadings(data);
                document.getElementById('lastUpdate').textContent =
                    'Updated ' + new Date().toLocaleTimeString();
            } catch (e) {
                document.getElementById('lastUpdate').textContent = 'Error loading data';
            }
        }

        load();
        refreshTimer = setInterval(load, 60000);
    </script>
</body>
</html>
