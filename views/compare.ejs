<!DOCTYPE html>
<html lang="en">
<head>
    <title>Day-over-Day Compare — AW Graphs</title>
    <%- include('partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <style>
        .date-pickers { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
        .date-label { font-size: 0.875rem; font-weight: 600; }
        input[type="date"] {
            padding: 0.45rem 0.6rem;
            border: 2px solid var(--border);
            border-radius: 0.4rem;
            font-family: inherit;
            font-size: 0.875rem;
            color: var(--text);
        }
        .legend-swatch { display: inline-block; width: 12px; height: 12px; border-radius: 2px; margin-right: 4px; vertical-align: middle; }
        .compare-legend { display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: 0.8rem; margin-top: 0.5rem; }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container">
        <div class="page-header">
            <h1 class="page-title">Day-over-Day Compare</h1>
        </div>

        <div class="controls">
            <div class="date-pickers">
                <div class="control-group">
                    <span class="date-label">Day A:</span>
                    <input type="date" id="dayA" value="<%= dayA %>">
                </div>
                <div class="control-group">
                    <span class="date-label">Day B:</span>
                    <input type="date" id="dayB" value="<%= dayB %>">
                </div>
                <button class="btn" id="loadBtn">Compare</button>
            </div>
            <div class="sensor-toggles" id="sensorToggles"></div>
        </div>

        <div class="card compare-legend" id="compareLegend"></div>

        <div class="chart-container" style="margin-top:0.75rem;">
            <canvas id="compareChart"></canvas>
        </div>

        <p style="font-size:0.8rem;color:var(--text-muted);margin-top:0.5rem;">
            Solid lines = Day A &nbsp;·&nbsp; Dashed lines = Day B &nbsp;·&nbsp;
            X-axis = hour of day (UTC). Use this view to assess HVAC effectiveness day-over-day.
        </p>
    </div>

    <script>
        const channels = <%- JSON.stringify(channels) %>;
        let chart = null;

        const loadBtn = document.getElementById('loadBtn');
        loadBtn.addEventListener('click', () => loadAndDraw());

        // Build sensor toggles
        const togglesEl = document.getElementById('sensorToggles');
        const toggleState = {};
        channels.forEach(ch => {
            toggleState[ch.key] = true;
            const btn = document.createElement('button');
            btn.className = 'toggle-btn active';
            btn.textContent = ch.name;
            btn.style.borderColor = ch.color;
            btn.dataset.key = ch.key;
            btn.onclick = () => {
                toggleState[ch.key] = !toggleState[ch.key];
                btn.classList.toggle('active', toggleState[ch.key]);
                if (chart) {
                    chart.data.datasets.forEach(ds => {
                        if (ds.channelKey === ch.key) ds.hidden = !toggleState[ch.key];
                    });
                    chart.update();
                }
            };
            togglesEl.appendChild(btn);
        });

        function hoursLabel(secondsIntoDay) {
            const h = Math.floor(secondsIntoDay / 3600);
            const m = Math.floor((secondsIntoDay % 3600) / 60);
            return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;
        }

        async function loadAndDraw() {
            const dayA = document.getElementById('dayA').value;
            const dayB = document.getElementById('dayB').value;
            if (!dayA || !dayB) return;

            // Update URL without reload
            const url = new URL(window.location);
            url.searchParams.set('dayA', dayA);
            url.searchParams.set('dayB', dayB);
            window.history.replaceState({}, '', url);

            const keys = channels.map(c => c.key).join(',');
            const res = await fetch(`/api/compare?channels=${keys}&dayA=${dayA}&dayB=${dayB}`);
            const { dayA: resA, dayB: resB } = await res.json();

            // Build a unified x-axis: 0 to 86400 seconds, every 5 minutes
            const STEP = 300; // 5 min
            const xLabels = [];
            for (let s = 0; s <= 86400; s += STEP) xLabels.push(s);

            function buildMap(readings) {
                const map = {};
                for (const r of readings) {
                    const bucket = Math.round(r.seconds_into_day / STEP) * STEP;
                    if (!map[r.channel_key]) map[r.channel_key] = {};
                    map[r.channel_key][bucket] = r.temp_f;
                }
                return map;
            }

            const mapA = buildMap(resA.readings);
            const mapB = buildMap(resB.readings);

            const datasets = [];
            channels.forEach(ch => {
                // Day A — solid
                datasets.push({
                    channelKey: ch.key,
                    label: `${ch.name} (${resA.date})`,
                    data: xLabels.map(s => mapA[ch.key]?.[s] ?? null),
                    borderColor: ch.color,
                    backgroundColor: ch.color,
                    borderWidth: 2,
                    pointRadius: 0,
                    tension: 0.1,
                    spanGaps: false,
                    borderDash: [],
                    hidden: !toggleState[ch.key],
                });
                // Day B — dashed
                datasets.push({
                    channelKey: ch.key,
                    label: `${ch.name} (${resB.date})`,
                    data: xLabels.map(s => mapB[ch.key]?.[s] ?? null),
                    borderColor: ch.color,
                    backgroundColor: ch.color,
                    borderWidth: 2,
                    pointRadius: 0,
                    tension: 0.1,
                    spanGaps: false,
                    borderDash: [6, 3],
                    hidden: !toggleState[ch.key],
                });
            });

            const ctx = document.getElementById('compareChart').getContext('2d');
            if (chart) chart.destroy();

            chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: xLabels.map(hoursLabel),
                    datasets,
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { intersect: false, mode: 'index' },
                    scales: {
                        y: {
                            beginAtZero: false,
                            title: { display: true, text: 'Temperature (°F)' },
                        },
                        x: {
                            ticks: { maxRotation: 45, maxTicksLimit: 25 },
                            title: { display: true, text: 'Hour of Day' },
                        },
                    },
                    plugins: {
                        legend: { display: false }, // We use custom legend below
                        tooltip: {
                            backgroundColor: 'rgba(255,255,255,0.95)',
                            titleColor: '#1e293b',
                            bodyColor: '#1e293b',
                            borderColor: '#e2e8f0',
                            borderWidth: 1,
                            callbacks: {
                                label: ctx => `${ctx.dataset.label}: ${ctx.parsed.y != null ? ctx.parsed.y.toFixed(1) + '°F' : '—'}`,
                            },
                        },
                    },
                },
            });

            // Build compact legend
            const legendEl = document.getElementById('compareLegend');
            legendEl.innerHTML = channels.map(ch => `
                <span>
                    <span class="legend-swatch" style="background:${ch.color}; border: 2px solid ${ch.color};"></span>
                    ${ch.name}
                    <span style="opacity:0.6"> ─ A &nbsp; - - B</span>
                </span>
            `).join('');
        }

        loadAndDraw().catch(console.error);
    </script>
</body>
</html>
