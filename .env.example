# ============================================================
# ClaudeAWGraphs Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Ambient Weather API (required) ---
# Get from ambientweather.net → Account → API Keys
AW_API_KEY=
AW_APP_KEY=
# MAC address of your weather station (from the AW app: Devices → Device Info)
AW_DEVICE_MAC=00:0E:C6:30:22:8B

# --- Daikin Integration (optional) ---
# Leave blank to disable Daikin integration entirely.
# When enabled, the local push agent (see agent/README.md) POSTs readings here.
# Generate a random token with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_TOKEN=

# --- Application ---
PORT=3000
NODE_ENV=production

# --- Data Retention ---
# How many days of history to keep in SQLite (older readings are pruned weekly)
DATA_RETENTION_DAYS=365

# --- Development ---
# Set to true to run without real hardware (generates synthetic data)
USE_MOCK_DATA=false
